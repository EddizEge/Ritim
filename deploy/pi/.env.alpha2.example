# Bu dosyayi deploy/pi/.env olarak kopyala. Gercek degerleri Git'e ekleme.
RITIM_DB_NAME=ritim
RITIM_DB_ADMIN_USER=ritim_admin
RITIM_DB_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
RITIM_DB_APP_PASSWORD=replace-with-a-different-long-random-app-password
RITIM_REDIS_PASSWORD=replace-with-a-long-random-redis-password
RITIM_DB_POOL_SIZE=10
RITIM_SOCIAL_BIND_PORT=8790

# Tarayıcı/Capacitor originleri birebir eşleşir. Native/Electron originsiz
# istekleri ayrıca kabul edilir. Cloudflare açıldığında public web originini ekle.
RITIM_ALLOWED_ORIGINS=http://localhost,https://localhost,capacitor://localhost,http://127.0.0.1:5173
# Gateway yalnızca loopback üzerinde olduğu sürece 0 kalır. Cloudflare rotası
# eklendiğinde tek güvenilir proxy hop'u için 1 yapılır.
RITIM_TRUST_PROXY=0
RITIM_RATE_WINDOW_MS=60000
RITIM_RATE_REQUESTS=180
RITIM_AUTH_RATE_WINDOW_MS=900000
RITIM_AUTH_RATE_REQUESTS=30
RITIM_SOCKET_RATE_WINDOW_MS=60000
RITIM_SOCKET_RATE_CONNECTIONS=45

# Kimlik servisini ancak gerçek Google OAuth istemci kimliklerini ekledikten
# sonra zorunlu yap. JWT secret en az 32 bayt, rastgele ve benzersiz olmalı.
RITIM_AUTH_REQUIRED=false
RITIM_AUTH_JWT_SECRET=
RITIM_GOOGLE_CLIENT_IDS=
# Google istemci türü token değişiminde secret gerektiriyorsa doldur.
RITIM_GOOGLE_CLIENT_SECRET=
