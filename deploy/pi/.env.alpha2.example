# Bu dosyayi deploy/pi/.env olarak kopyala. Gercek degerleri Git'e ekleme.
RITIM_DB_NAME=ritim
RITIM_DB_ADMIN_USER=ritim_admin
RITIM_DB_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
RITIM_DB_APP_PASSWORD=replace-with-a-different-long-random-app-password
RITIM_REDIS_PASSWORD=replace-with-a-long-random-redis-password
RITIM_DB_POOL_SIZE=10
RITIM_SOCIAL_BIND_PORT=8790

# Kimlik servisini ancak gerçek Google OAuth istemci kimliklerini ekledikten
# sonra zorunlu yap. JWT secret en az 32 bayt, rastgele ve benzersiz olmalı.
RITIM_AUTH_REQUIRED=false
RITIM_AUTH_JWT_SECRET=
RITIM_GOOGLE_CLIENT_IDS=
# Yalnızca confidential Web OAuth istemcisi kullanılıyorsa doldur.
RITIM_GOOGLE_CLIENT_SECRET=
