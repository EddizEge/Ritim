[Unit]
Description=Ritim Alpha.2 encrypted daily PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/DATA/AppData/ritim-alpha2/source/deploy/pi/backup/ritim-backup.sh /media/<kullanıcı>/<4tb-disk>/RitimBackups/daily 14
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
