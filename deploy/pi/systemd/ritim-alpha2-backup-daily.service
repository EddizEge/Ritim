[Unit]
Description=Ritim Alpha.2 encrypted daily PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Yedek hedefleri bu Pi'ye özeldir ve depoda tutulmaz (bkz. deploy/pi/README.md).
EnvironmentFile=/DATA/AppData/ritim-alpha2/secrets/backup-targets.env
ExecStart=/DATA/AppData/ritim-alpha2/source/deploy/pi/backup/ritim-backup.sh ${RITIM_BACKUP_DAILY_DIR} 14
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
