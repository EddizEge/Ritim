[Unit]
Description=Ritim Alpha.2 encrypted weekly PostgreSQL backup and restore smoke test
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Yedek hedefleri bu Pi'ye özeldir ve depoda tutulmaz (bkz. deploy/pi/README.md).
EnvironmentFile=/DATA/AppData/ritim-alpha2/secrets/backup-targets.env
ExecStart=/DATA/AppData/ritim-alpha2/source/deploy/pi/backup/ritim-backup.sh ${RITIM_BACKUP_WEEKLY_DIR} 180
ExecStartPost=/DATA/AppData/ritim-alpha2/source/deploy/pi/backup/ritim-restore-smoke.sh ${RITIM_BACKUP_WEEKLY_DIR}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
