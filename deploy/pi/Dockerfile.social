FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.social.json ./
COPY server ./server
RUN npm exec tsc -- -p tsconfig.social.json

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY --from=build /app/dist-social/server ./server
COPY server/package.json ./server/package.json
COPY electron/social-hub.cjs ./electron/social-hub.cjs

USER node
EXPOSE 8790
CMD ["node", "server/social.js"]
