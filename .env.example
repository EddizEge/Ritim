# Telefon farkli bir sunucuya baglanacaksa:
# VITE_SYNC_URL=http://192.168.1.20:8787

# Merkezi Ritim Social servisi build sırasında web/Android paketine yazılır.
# Üretim paketleri varsayılan olarak aşağıdaki HTTPS/WSS adresini kullanır.
# Geliştirmede bu değer verilmezse yerel 8790 gateway'i kullanılır:
# VITE_SOCIAL_URL=https://social.edizegemercan.com.tr
# RITIM_SOCIAL_URL=https://social.edizegemercan.com.tr
# Gerektiğinde yerel SSH tüneliyle override edilebilir:
# VITE_SOCIAL_URL=http://127.0.0.1:18790

# Alpha.2 gateway altyapısı. Bellek içi geliştirmede boş bırakılabilir:
# RITIM_INFRA_REQUIRED=false
# RITIM_DB_HOST=127.0.0.1
# RITIM_DB_PORT=5432
# RITIM_DB_NAME=ritim
# RITIM_DB_USER=ritim_app
# RITIM_DB_PASSWORD=change-me
# RITIM_DB_POOL_SIZE=10
# RITIM_REDIS_HOST=127.0.0.1
# RITIM_REDIS_PORT=6379
# RITIM_REDIS_PASSWORD=change-me

# Discord Developer Portal uygulama kimligi (yalnizca masaustu kabugu okur):
# RITIM_DISCORD_CLIENT_ID=123456789012345678

# Google bilgileri uygulamadaki kurulum ekranindan girilebilir. İsterseniz
# gelistirme ortaminda ana surece ortam degiskeni olarak da verebilirsiniz:
# RITIM_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# RITIM_GOOGLE_CLIENT_SECRET=GOCSPX-...
