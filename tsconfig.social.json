{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-social",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "server/social.ts",
    "server/social-auth.ts",
    "server/social-infrastructure.ts",
    "server/social-security.ts",
    "server/social-store.ts"
  ]
}
